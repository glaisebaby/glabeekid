{
  "name": "glabeekid",
  "private": false,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@glabeekid/backend",
    "backend:dev": "turbo dev --filter=@glabeekid/backend",
    "storefront:dev": "turbo dev --filter=@glabeekid/storefront",
    "keepalive:check": "npm --prefix apps/keepalive-worker run check",
    "keepalive:deploy": "npm --prefix apps/keepalive-worker run deploy"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.18.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14",
    "ajv": "^8.13.0"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**"
  ],
  "overrides": {
    "react": "19.0.5",
    "react-dom": "19.0.5",
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    }
  }
}
